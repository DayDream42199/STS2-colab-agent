# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# --- Tooling / editors -----------------------------------------------------
# Claude Code keeps two kinds of settings, and only one of them is personal:
#   .claude/settings.local.json   per-machine (a permission allowlist here) -- ignore
#   .claude/settings.json         shared project config -- COMMIT it
# So this ignores the local file specifically rather than the whole folder.
# Blanket-ignoring .claude/ would silently block shared hooks or project
# permissions if they are ever added.
.claude/settings.local.json
.claude/*.local.json

.vscode/
.idea/
*.swp
*~

# --- OS junk ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Training output -------------------------------------------------------
# Anything a training run produces rather than a human writing it.
#
# DELIBERATELY NOT IGNORED: simple_agent.pt, the worked example the README
# points at. Keeping it means someone can clone and run
# `python testing/train_torch.py play` without training first. The negation
# has to come after the *.pt rule that would otherwise catch it.
*.npz
*.zip
*.pth
*.ckpt
*.pt
!simple_agent.pt

# Tensorboard / run logs
runs/
logs/
tb_logs/
*.log

# Benchmark and diagnostic dumps
*.prof
balance_*.json
